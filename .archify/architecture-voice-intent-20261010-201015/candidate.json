      "dot": "rose",
      "title": "Zero-Trust Intent Firewall",
      "items": [
        "Google Gemini extracts structured JSON intents but cannot sign or broadcast transactions",
        "Deterministic rule engine enforces confidence >= 0.90, balance limits, and Circle USDC contract match",
        "Issues cryptographic single-use UUID approval token with 5-minute TTL upon PASS verdict"
      ]
    },
    {
      "dot": "emerald",
      "title": "Execution & Balance Verification",
      "items": [
        "Pre-execution native ETH and USDC balances captured in canonical integer base units (bigint)",
        "Atomic token consumption before async broadcast eliminates double-spend concurrency races",
        "Post-receipt delta verification calculates observed integer balance deltas to generate 5-item audit checklist"
      ]
    },
    {
      "dot": "cyan",
      "title": "Safety & Network Guarantees",
      "items": [
        "Strict fail-closed startup and pre-flight assertions for Sepolia Chain ID 11155111",
        "Deterministic regex fallback parser handles core transfers if LLM extraction times out (10s)",
        "Local server binds exclusively to 127.0.0.1 with Helmet security headers and rate limiting"
      ]
    }
